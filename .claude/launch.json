{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "abm-wrapper-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd wrapper/backend && .venv/bin/python3 -m uvicorn app.main:app --port 8731 --app-dir ."],
      "port": 8731
    },
    {
      "name": "abm-wrapper-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd wrapper/frontend && npm run dev -- --port 5173"],
      "port": 5173
    },
    {
      "name": "abm-wrapper-inngest-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["inngest-cli@latest", "dev", "-u", "http://127.0.0.1:8731/api/inngest", "--port", "8288"],
      "port": 8288
    }
  ]
}
