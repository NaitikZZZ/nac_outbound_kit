# Xoxoday Outbound Kit - API Keys
# Copy this file to .env and fill in your personal keys.
# Never commit .env to git (it's in .gitignore).

# Saleshandy - Settings > API Keys in Saleshandy dashboard
SALESHANDY_API_KEY=your_key_here

# Smartlead - Settings > API Keys in Smartlead dashboard
SMARTLEAD_API_KEY=your_smartlead_key_here

# Apollo - Settings > Integrations > API in Apollo
APOLLO_API_KEY=your_apollo_key_here

# ZeroBounce - My Account > API
ZEROBOUNCE_API_KEY=your_zerobounce_key_here

# HeyReach - Settings > API (if not using MCP connector)
HEYREACH_API_KEY=your_heyreach_key_here

# Clay - Workspace Settings > API (only if running Clay waterfalls programmatically)
CLAY_API_KEY=your_clay_key_here

# Interakt (WhatsApp) - Developer Settings in Interakt dashboard
INTERAKT_API_KEY=your_interakt_api_key_here

# HubSpot Private App token - required by the hubspot-abm-exclusion skill and abm-wrapper
# (scopes: crm.objects.contacts.read, crm.lists.read)
HUBSPOT_API_KEY=your_hubspot_private_app_token
HUBSPOT_PORTAL_ID=your_hubspot_portal_id
HUBSPOT_EXCLUSION_LIST_ID=your_hubspot_dnu_list_id

# Optional: HubSpot Record ID used as primary key on HubSpot imports
HUBSPOT_RECORD_ID=your_hubspot_record_id_here

# Anthropic - console.anthropic.com/settings/keys
# Used by abm-wrapper's Claude-based domain resolution fallback and Copy Agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here
